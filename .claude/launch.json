{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "floodrisk.api.dev"],
      "port": 8000
    },
    {
      "name": "api-real",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "floodrisk.api.dev", "--real"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["web/node_modules/vite/bin/vite.js", "web", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["web/node_modules/vite/bin/vite.js", "preview", "web", "--port", "4173", "--strictPort"],
      "port": 4173
    }
  ]
}
